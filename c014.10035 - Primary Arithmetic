#include <stdio.h>

int main(){
    int a, b, c, cnt;
    
    while(scanf("%d %d", &a, &b) && ((a != 0) || (b != 0))){
        c = 0;
        cnt = 0;
        for(int i = 0; i < 10; i++){
            if((a % 10)+(b % 10) + c >9){ 
                c = 1;
                cnt++;
            }
            else{c = 0;}
            a /= 10;
            b /= 10;
        }
        if(cnt >1){
            printf("%d carry operations.\n", cnt);
        }
        else if(cnt == 1){
            printf("1 carry operation.\n");
        }
        else{printf("No carry operation.\n");}
    }
    return 0;
}
